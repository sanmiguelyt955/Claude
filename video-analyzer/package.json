{
  "name": "claude-video-analyzer",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@cva/web",
    "worker": "npm run dev --workspace=@cva/worker",
    "build": "npm run build --workspace=@cva/web",
    "db:migrate": "npm run migrate --workspace=@cva/memory-engine",
    "db:check": "npm run check --workspace=@cva/memory-engine",
    "typecheck": "tsc --noEmit -p packages/memory-engine && tsc --noEmit -p packages/video-processor && tsc --noEmit -p packages/ai-router && tsc --noEmit -p packages/skill-engine && tsc --noEmit -p packages/vault-export && tsc --noEmit -p apps/worker && tsc --noEmit -p apps/web && tsc --noEmit -p packages/perception",
    "test:perception": "node --import tsx --test --test-reporter=dot packages/perception/test/*.test.ts",
    "test:worker": "node --import tsx --test --test-reporter=dot apps/worker/test/*.test.ts",
    "test": "npm run test:whisper && npm run test:perception && npm run test:video-processor && npm run test:worker && npm run test:skills && npm run test:web && npm run test:memory",
    "test:whisper": "python3 -m unittest discover -s packages/perception/scripts/tests",
    "test:video-processor": "node --import tsx --test --test-reporter=dot packages/video-processor/test/*.test.ts",
    "test:skills": "node --import tsx --test --test-reporter=dot packages/skill-engine/test/*.test.ts",
    "test:web": "node --import tsx --test --test-reporter=dot apps/web/test/*.test.ts",
    "test:memory": "node --import tsx --test --test-reporter=dot packages/memory-engine/test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "ffmpeg-static@5.3.0": true,
    "protobufjs@7.6.6": true,
    "better-sqlite3@13.0.3": true,
    "@google/genai@2.21.0": true
  }
}
