{
  "name": "video-analyzer-desktop",
  "productName": "Video Analyzer",
  "version": "1.0.0",
  "private": true,
  "description": "Video Analyzer: mira, escucha y analiza videos, y conversa con ellos",
  "author": "sanmiguelyt955",
  "main": "main.js",
  "scripts": {
    "prepare-runtime": "node scripts/prepare-runtime.mjs",
    "smoke": "node scripts/smoke.mjs",
    "app": "electron .",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux dir --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  },
  "build": {
    "appId": "com.sanmiguelyt955.videoanalyzer",
    "productName": "Video Analyzer",
    "artifactName": "Video-Analyzer-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "runtime.js",
      "updater.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime"
      }
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "dir"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "generic",
      "url": "https://github.com/sanmiguelyt955/Claude/releases/download/video-analyzer-latest"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
