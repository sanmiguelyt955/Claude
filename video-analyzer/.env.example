# ── Gemini ────────────────────────────────────────────────────────────────
# Obtener en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Motor de video understanding.
# gemini-3.8-flash: el que Google recomienda para proyectos nuevos. En modo
#   agentic fue inestable en videos largos ("Model generated too many tool
#   calls"); con STATIC (abajo) no aplica. Free tier ~20 RPD.
# gemini-3.7-flash ya no aparece en la lista de modelos de Google (revisada el
#   2026-10-17): no usarlo.
GEMINI_VIDEO_MODEL=gemini-3.8-flash

# STATIC | AGENTIC. AGENTIC ahorra hasta 88% de tokens de video, pero en este
# proyecto lleva 0 de 2 analisis completados: se queda colgado sin respuesta ni
# error (25 y 35 minutos) y cada intento gasta una peticion real del cupo
# diario. STATIC es el unico modo que ha terminado un analisis (227s). El cupo
# libre se mide en peticiones/dia, no en tokens/dia, asi que ahorrar tokens no
# compra nada y colgarse cuesta caro. Volver a AGENTIC solo si se estabiliza.
GEMINI_VIDEO_PROCESSING=STATIC

# Motor de razonamiento para deteccion/generacion/mejora de Skills: es el
# primero que se prueba; si no tiene cupo siguen los de GEMINI_VIDEO_MODELS.
# Comparte el cupo diario de cada modelo con el video. Para guardar los 20
# diarios de gemini-3.8-flash para los analisis, pon aqui un Flash-Lite
# (500 al dia), p. ej. GEMINI_SKILL_MODEL=gemini-3.5-flash-lite. Para fijar
# la lista exacta: GEMINI_SKILL_MODELS=modelo1,modelo2.
GEMINI_SKILL_MODEL=gemini-3.8-flash

# Modelo de embeddings. Cambiarlo obliga a reindexar toda la memoria.
# Cupo propio y mucho mas amplio (ver abajo), no compite con el de video.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# ── Limites de cuota ──────────────────────────────────────────────────────
# Verificados en https://aistudio.google.com/rate-limit el 2026-09-10 para
# esta cuenta, free tier. IMPORTANTE: son mucho mas bajos que lo asumido
# originalmente en PROJECT.md seccion 16 (10 RPM / 1.500 RPD) — Google movio
# estos numeros en algun punto entre el cierre de esa investigacion y hoy.
# Re-verificar en ese panel si la app empieza a devolver 429 antes de lo que
# estos valores predicen.
#
# gemini-3.8-flash (y antes gemini-3.7-flash, idéntico en esta cuenta):
#   RPM=5  TPM=250000  RPD=20
# gemini-embedding-001 (cupo aparte, no compite con el de video/skills):
#   RPM=100  TPM=30000  RPD=1000
#
# RPD=20 es el limite que de verdad importa aqui: first_pass + deep_pass +
# skill_detection ya son 3 llamadas de las 20 por un solo video. El rate
# limiter local debe frenar ANTES de gastar el cupo diario, no reaccionar
# despues del primer 429.
GEMINI_MAX_RPM=5
GEMINI_MAX_TPM=250000
GEMINI_MAX_RPD=20
# Los embeddings no tienen limite local: indexan de a 80 fragmentos por
# minuto y, si Google responde 429, esperan lo que el propio Google indica.

# ── Almacenamiento local ──────────────────────────────────────────────────
DATA_DIR=./data
SQLITE_PATH=./data/db/app.sqlite

# ── Worker ────────────────────────────────────────────────────────────────
WORKER_POLL_INTERVAL_MS=1500
WORKER_CONCURRENCY=1

# ── Exportación a Obsidian ────────────────────────────────────────────────
# Ruta ABSOLUTA a la carpeta raiz del vault (la que contiene "01 Investigacion
# de productos", "03 Guiones y contenido", etc.). Sin esto, el boton
# "Exportar a Obsidian" devuelve error en vez de adivinar una ruta.
OBSIDIAN_VAULT_PATH=
# Carpeta del vault donde caen las notas de video exportadas.
OBSIDIAN_VIDEO_FOLDER=03 Guiones y contenido

# ── Rotacion de modelos (mas analisis por dia) ────────────────────────────
# El cupo diario de Google es POR MODELO: su propio error 429 lo reporta como
# "GenerateRequestsPerDayPerProjectPerModel-FreeTier" con dimension model.
# Listar varios modelos aqui multiplica la capacidad real: 20/dia por cada uno.
# El worker recorre la lista en orden y salta al siguiente en cuanto uno se
# queda sin cupo (tanto por el contador local como por un 429 real).
# Solo modelos de la lista actual de Google: 3.7 Flash y 3.5 Flash ya no
# aparecen y solo gastaban intentos.
GEMINI_VIDEO_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# El cupo diario del free tier NO se reinicia a medianoche UTC sino a
# medianoche del Pacifico. Contar en UTC daba via libre falsa hasta 8h al dia.
GEMINI_QUOTA_TIMEZONE=America/Los_Angeles

# ── Lotes (varios videos en una sola peticion) ────────────────────────────
# El free tier limita PETICIONES por dia, no videos: mandar varios videos en
# una sola llamada hace que N videos cuesten lo que antes costaba 1. El tope
# de salida (65k tokens) se reparte entre todos, asi que el lote debe ser
# chico para que cada video siga teniendo su analisis exhaustivo.
# Bajado de 600 a 150 y luego a 75: el esquema de escenas exige EXACTAMENTE
# un objeto por segundo (nunca fusionar varios segundos en una entrada), asi
# que la misma duracion combinada de antes necesita mas presupuesto de salida
# del que el lote realmente tiene. Un video individual mas largo que esto no
# entra al lote aunque sobre espacio -- pasa por el camino de un solo video
# (ver ventaneo).
GEMINI_BATCH_MAX_VIDEOS=5
GEMINI_BATCH_MAX_SECONDS=75

# ── Ventaneo de videos largos (segundo a segundo, UN objeto por segundo) ──
# Un video mas largo que GEMINI_WINDOW_THRESHOLD_SECONDS se corta en tramos
# de GEMINI_WINDOW_SECONDS y cada tramo es SU PROPIA peticion a Gemini (misma
# subida, recortada con startOffset/endOffset) -- necesario porque el esquema
# de escenas exige EXACTAMENTE un objeto por segundo (nunca fusionar varios
# segundos en uno), lo que excede el tope de 65k tokens de salida en un video
# de mas de ~110s. Esto multiplica el cupo diario que gasta un video largo:
# uno de 7 min puede usar 10-15 peticiones del mismo modelo en vez de 1.
# Decision consciente, confirmada con el dueno de la cuenta.
# Bajado de 90 a 45: al exigir un objeto por segundo (sin poder agrupar un
# plano fijo en una sola entrada), el mismo tramo produce mas JSON que antes.
GEMINI_WINDOW_SECONDS=45
GEMINI_WINDOW_THRESHOLD_SECONDS=110
# fps mas alto que el default de generateContent (1.0) para que el modelo
# tenga frames suficientes para narrar escenas de 1-4s con precision.
GEMINI_WINDOW_FPS=2
# Espera base (con +-25% de variacion aleatoria) antes de reintentar UNA vez un
# tramo que fallo por un error no clasificado (corte de red, JSON roto).
GEMINI_WINDOW_CALL_DELAY_MS=13000
# Tramos del mismo video analizados al mismo tiempo. Cada llamada tarda ~60-95s;
# en serie el limite por minuto quedaba casi sin usar. El ritmo por modelo
# (60s / GEMINI_MAX_RPM entre inicios de peticion) se respeta igual, asi que
# subir esto no puede exceder el limite por minuto.
GEMINI_WINDOW_CONCURRENCY=4
# Un 503 ("high demand") es temporal: el modelo se salta solo durante este
# tiempo y luego se vuelve a usar para los siguientes tramos, en vez de
# abandonarlo para el resto del video.
GEMINI_OVERLOAD_COOLDOWN_MS=60000

# ── Limites reales por modelo ─────────────────────────────────────────────
# Google NO publica los limites del free tier por modelo: el unico lugar donde
# se ven es tu propio panel en https://aistudio.google.com/rate-limit
# Copialos aqui como "modelo=RPD" separados por comas y la app dejara de
# asumir GEMINI_MAX_RPD para todos. Un 429 real siempre tiene prioridad sobre
# lo que se escriba aqui, porque ese dato viene de Google.
# Ejemplo: GEMINI_MODEL_DAILY_LIMITS=gemini-3.8-flash=20,gemini-2.5-flash=250
GEMINI_MODEL_DAILY_LIMITS=gemini-3.8-flash=20,gemini-3.6-flash=20,gemini-3.5-flash-lite=500,gemini-3.1-flash-lite=500

# Tope de espera del modo agentic antes de caer a static. El modo agentic
# puede colgarse indefinidamente en videos largos (visto en vivo: 35+ min sin
# respuesta ni error), y static siempre funciona como respaldo.
GEMINI_AGENTIC_TIMEOUT_MS=480000

# Mismo problema que el timeout de agentic, mas raro: una llamada STATIC
# (generateContent) puede tambien quedarse colgada sin respuesta ni error
# (visto en vivo: 5+ min en gemini-3.6-flash mientras modelos hermanos
# devolvian 503 al toque). Aplica tanto a un analisis normal como a cada
# ventana de un video largo.
GEMINI_STATIC_TIMEOUT_MS=240000

# ── Percepción (ver + escuchar) — packages/perception ─────────────────────
# perception = el worker analiza con frames + Whisper + cadena de proveedores
# (Gemini, Claude). Vacío = el camino de Gemini con el video completo de siempre.
# Los lotes de varios videos siguen yendo por Gemini.
ANALYSIS_ENGINE=
# Cadena de proveedores de visión, en orden. Los que no tengan clave se saltan.
# Ante 503/429 se pasa al siguiente y el que saturó queda en pausa 60 s.
# Claude no procesa audio: recibe fotogramas + transcripción como texto.
ANTHROPIC_API_KEY=
CLAUDE_VISION_MODEL=claude-sonnet-5-5
# Gemini usa GEMINI_API_KEY (arriba). Cada modelo de la lista es un proveedor
# aparte: si uno satura (503/429) se pasa al siguiente modelo de Gemini y, al
# final, a Claude. Solo modelos de la lista actual de Google
# (ai.google.dev/gemini-api/docs/models, revisada el 2026-10-17).
# GEMINI_VISION_MODEL (uno solo) se sigue aceptando si no hay lista.
GEMINI_VISION_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite
# Si TODOS los proveedores están saturados, se espera su Retry-After (máx. 2 min)
# y se reintenta, hasta 4 rondas, antes de fallar el job.
# Tope por llamada a Claude: una petición colgada cuenta como saturación.
VISION_TIMEOUT_MS=240000
# Gemini responde por streaming (como recomienda su guía de video): se corta
# solo si pasan VISION_IDLE_TIMEOUT_MS sin recibir nada, con un tope total de
# VISION_STREAM_TIMEOUT_MS.
VISION_IDLE_TIMEOUT_MS=180000
VISION_STREAM_TIMEOUT_MS=600000
# Calidad con la que Gemini lee cada fotograma. MEDIUM (560 tokens por imagen)
# Tokens por fotograma medidos con countTokens: LOW 264, MEDIUM 527, HIGH 1.100.
# LOW leyó exacto el texto pequeño de la pantalla en una prueba de 300
# fotogramas, así que cada tramo lleva 300 fotogramas por el mismo coste que
# 100 en MEDIUM. Pon MEDIUM para letra muy fina; vacío deja el de Google. Si un
# modelo no lo acepta, la app repite la petición sin él.
GEMINI_MEDIA_RESOLUTION=MEDIA_RESOLUTION_LOW
# Tramos que pueden ir a Gemini a la vez. La app no manda ninguno que pase el
# límite por minuto de cada modelo (espera su turno), así que 8 no causa
# rechazos: con 3, en un video de 15 minutos los últimos tramos esperaban
# casi dos minutos sin motivo.
VISION_CONCURRENCY=8
# Segundos de video por tramo del registro V6.5. Con 120 Gemini escribe la
# línea de tiempo de cada tramo en la mitad de tiempo que con 240 y los tramos
# van en paralelo (15 min: unas 10 peticiones en vez de 7, 4 min en vez de 6).
V6_WINDOW_SECONDS=120
# Descargas de TikTok, Instagram y YouTube (yt-dlp, incluido en requirements.txt).
# Instagram y algunos TikTok solo dejan descargar con sesión iniciada: pon el
# navegador donde la tienes abierta (firefox, edge, chrome, safari) o un
# archivo cookies.txt exportado.
YTDLP_COOKIES_FROM_BROWSER=
YTDLP_COOKIES_FILE=
# Fuerza que yt-dlp se presente como un navegador en cada petición (p. ej.
# chrome). Solo si TikTok sigue bloqueando: yt-dlp avisa que puede volver las
# descargas más lentas.
YTDLP_IMPERSONATE=
# Subtitles of the post (TikTok, YouTube) are saved next to the video and
# read instead of running Whisper: written ones in the spoken language, else
# the automatic track in the original language. 0 always uses Whisper.
USE_PLATFORM_CAPTIONS=1

# Whisper (escuchar). Vacío = faster-whisper por lotes si está instalado (15 min
# de voz en ~1,5 min), si no nuestro Whisper en NumPy (~14 min). propio o
# faster-whisper fuerzan uno. Instalar: pip install -r packages/perception/scripts/requirements.txt
# parakeet = Parakeet de NVIDIA: sin tarjeta gráfica transcribe 15 min en ~1:20
# en vez de ~2:10, pero en una prueba real cambió 7 de 162 frases en español
# a medio inglés. Solo para cuando la rapidez importe más que la exactitud.
WHISPER_ENGINE=
# faster-whisper por lotes: cuántos tramos de voz decodifica a la vez. 0 en
# WHISPER_BATCHED lo hace uno por uno (más lento, mismo resultado).
WHISPER_BATCHED=1
# Dónde transcribe faster-whisper: auto usa la tarjeta NVIDIA si hay (float16;
# el lanzador instala sus librerías CUDA) y si no, o si falla, el procesador.
WHISPER_DEVICE=auto
WHISPER_BATCH_SIZE=4
# Modelo en la tarjeta NVIDIA (más preciso; ~1,6 GB, se descarga una vez). Vacío = el mismo que en el procesador.
WHISPER_GPU_MODEL=large-v3-turbo
# Haces del beam search: 5 = lo habitual en Whisper (más preciso, ~2x el tiempo);
# 1 = greedy (más rápido).
WHISPER_BEAM_SIZE=5
# Reintento con temperatura: una ventana que sale repetitiva (bucle) o con baja
# confianza se decodifica otra vez a 0.2, 0.4 ... 1.0 con muestreo. 0 = apagado.
WHISPER_TEMPERATURE_FALLBACK=1
# Tamaño: tiny, base, small, medium, large-v3, large-v3-turbo. Los pesos se
# descargan una vez desde Hugging Face (openai/whisper-*).
WHISPER_MODEL=small
# Separar quién habla (Hablante 1, Hablante 2...) en el análisis local. Usa el
# modelo de voces de WeSpeaker (26 MB, se descarga una vez; licencia CC-BY-4.0).
# 0 lo apaga. DIARIZATION_MERGE_SIMILARITY: subir (p. ej. 0.8) si junta a dos
# personas en una; bajar (0.6) si parte a una persona en dos.
DIARIZATION=1
DIARIZATION_MERGE_SIMILARITY=0.7
# Ruta a un voxceleb_resnet34_LM.onnx ya descargado (sin internet).
DIARIZATION_MODEL_PATH=
PYTHON_BIN=python3
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
