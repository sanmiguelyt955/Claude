{
  "name": "vertiflow",
  "version": "0.2.0",
  "description": "De un puñado de clips, muchos vídeos verticales distintos. Procesado local con FFmpeg.",
  "private": true,
  "type": "commonjs",
  "bin": {
    "vertiflow": "bin/cli.js"
  },
  "scripts": {
    "start": "node bin/cli.js app",
    "desktop": "electron .",
    "mcp": "node mcp/server.js",
    "test": "node --test",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "busboy": "^1.6.0",
    "express": "^4.22.3",
    "qrcode": "^1.5.4",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "productName": "Vertiflow",
  "main": "electron/main.js",
  "optionalDependencies": {
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.vertiflow.app",
    "productName": "Vertiflow",
    "files": [
      "bin/**",
      "electron/**",
      "mcp/**",
      "public/**",
      "server/**",
      "src/**",
      "package.json",
      "!**/test/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.video"
    }
  }
}
