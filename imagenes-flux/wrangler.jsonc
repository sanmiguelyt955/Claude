{
  // imagenes-flux: MCP de imágenes con FLUX en Cloudflare Workers AI (cuota gratis diaria: 10 000 neuronas).
  // Secreto (no aquí): CLAVE  →  la URL del conector es https://imagenes-flux.<cuenta>.workers.dev/<CLAVE>/mcp
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "imagenes-flux",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "ai": { "binding": "AI" },
  "kv_namespaces": [{ "binding": "IMG", "id": "7ba595f5716c421fabec2037516c1710" }],
  "observability": { "enabled": true }
}
